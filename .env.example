# Copy to ~/.amazon-ads-mcp/.env (or ./.env, or any file passed with --env) and fill in.
# Make it owner-only (chmod 600). Never commit real values.
# Variables already set in the environment (e.g. your MCP client config) win over this file.

# --- Required ---

# Login with Amazon security profile credentials
# (Amazon Developer console -> Login with Amazon -> your security profile ->
# "Show Client ID and Client Secret"). This profile must have Amazon Ads API access.
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=

# Region of your ads accounts: NA (US, CA, MX, BR), EU (UK and Europe, Middle East,
# India, South Africa) or FE (JP, AU, SG). UK accounts are EU.
AMAZON_ADS_REGION=EU

# --- Refresh token (set ONE of these, or neither if you use the default file) ---

# `amazon-ads-mcp auth` saves the refresh token here (default
# ~/.amazon-ads-mcp/secrets/amazon-ads-token.json, owner-only permissions).
AMAZON_ADS_TOKEN_FILE=
# Or put the refresh token itself here (starts with Atzr|). Prefer the file.
AMAZON_ADS_REFRESH_TOKEN=

# --- Optional ---

# Default advertiser profile (amazon_ads_list_profiles shows them). Tools also take profile_id.
AMAZON_ADS_PROFILE_ID=

# Start in dry-run: writes are logged and previewed but NOT sent to Amazon.
AMAZON_ADS_DRY_RUN=true

# Register only read-only tools (lists, reports, recommendations).
AMAZON_ADS_READ_ONLY=false

# Only register some tool groups, e.g. profiles,sp_campaigns,sp_targeting,reporting
AMAZON_ADS_TOOL_GROUPS=

# Safety limits: writes beyond these need confirm='APPLY'.
AMAZON_ADS_BULK_THRESHOLD=10
AMAZON_ADS_MAX_INCREASE_PCT=25
# Optional absolute caps in the profile's currency (blank = no cap).
AMAZON_ADS_MAX_BUDGET=
AMAZON_ADS_MAX_BID=

# Audit log of writes (JSONL, default ~/.amazon-ads-mcp/logs/audit.jsonl) and how many
# days to keep entries (0 = forever).
AMAZON_ADS_AUDIT_LOG=
AMAZON_ADS_AUDIT_RETENTION_DAYS=30

# Results per page for list calls, and per-request timeout in seconds.
AMAZON_ADS_PAGE_SIZE=100
AMAZON_ADS_TIMEOUT=30

AMAZON_ADS_LOG_LEVEL=INFO

# Transport: stdio (Claude Code / Desktop) or streamable-http (served at /mcp).
AMAZON_ADS_TRANSPORT=stdio
AMAZON_ADS_HOST=127.0.0.1
AMAZON_ADS_PORT=8000
# HTTP has no sign-in, so a host other than 127.0.0.1/localhost is refused unless this
# is true. Only set it behind an authenticating proxy.
AMAZON_ADS_ALLOW_REMOTE=false
